{
  "expo": {
    "name": "OZIRA AI",
    "slug": "ozira-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "scheme": "ozira",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ozira.ai",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ozira.ai",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#0B0B12",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B0B12",
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-audio",
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosConfig": {
            "microphoneUsageDescription": "Allow OZIRA AI to use your microphone for Live voice."
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OZIRA AI to share camera frames during Live conversations.",
          "microphonePermission": "Allow OZIRA AI to use your microphone for Live voice.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OZIRA AI to access your photos.",
          "savePhotosPermission": "Allow OZIRA AI to save generated images.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "1b5a6a45-fc3d-405a-9250-14c3774ff11c"
      }
    }
  }
}
